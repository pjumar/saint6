# Strapi CMS Configuration
# ========================
# These environment variables are required for Strapi CMS integration.

# Strapi API Token (required for build-time data fetching)
# Get this from Strapi Admin > Settings > API Tokens
STRAPI_API_TOKEN=your_api_token_here

# Strapi URL (optional - defaults to production Strapi Cloud instance)
# Only override if using a different Strapi instance
NEXT_PUBLIC_STRAPI_URL=https://fantastic-attraction-7b2626fe03.strapiapp.com

# Site URL (optional - defaults to https://saint6.studio)
# Used for generating absolute OG image URLs
NEXT_PUBLIC_SITE_URL=https://saint6.studio

# Bunny.net CDN URL (optional - rewrites Strapi media URLs through CDN)
# Create a Pull Zone on bunny.net with your Strapi media host as origin
NEXT_PUBLIC_CDN_URL=https://saint6.b-cdn.net

# Styling is preview-only until the CMS content and production release are approved.
# In Preview, omit STYLING_CONTENT_SOURCE to use the bilingual review fixtures.
# To read the new published Strapi content types:
# STYLING_CONTENT_SOURCE=cms
# Optional staging overrides (server-only; never use NEXT_PUBLIC for the token):
# STYLING_STRAPI_URL=https://your-staging-strapi.example
# STYLING_STRAPI_TOKEN=your_read_only_token
# Set only for the approved production launch, together with CMS mode:
# STYLING_PUBLIC_ENABLED=true
