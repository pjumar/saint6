# Strapi CMS Configuration
# ========================
# These environment variables are required for Strapi CMS integration.

# Strapi API Token (required for build-time data fetching)
# Get this from Strapi Admin > Settings > API Tokens
STRAPI_API_TOKEN=your_api_token_here

# Strapi URL (optional - defaults to production Strapi Cloud instance)
# Only override if using a different Strapi instance
NEXT_PUBLIC_STRAPI_URL=https://fantastic-attraction-7b2626fe03.strapiapp.com
