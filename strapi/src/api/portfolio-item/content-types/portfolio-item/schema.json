{
  "kind": "collectionType",
  "collectionName": "portfolio_items",
  "info": {
    "singularName": "portfolio-item",
    "pluralName": "portfolio-items",
    "displayName": "Portfolio Item",
    "description": "Portfolio showcase items"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "aspectRatio": {
      "type": "enumeration",
      "enum": ["w2_h3", "w2_h5", "w3_h2", "w3_h4", "w3_h5", "w4_h3", "w4_h5", "w5_h4", "w5_h7", "w7_h9", "w9_h16", "w16_h9"],
      "required": true,
      "default": "w2_h3",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "page": {
      "type": "enumeration",
      "enum": ["creative", "set-design", "decor"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
