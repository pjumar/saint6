{
  "kind": "singleType",
  "collectionName": "creative_pages",
  "info": {
    "singularName": "creative-page",
    "pluralName": "creative-pages",
    "displayName": "Creative Page",
    "description": "Creative services page content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "clients": {
      "type": "component",
      "repeatable": false,
      "component": "shared.clients-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "client_logos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::brand-logo.brand-logo"
    },
    "services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service-item.service-item"
    },
    "intro": {
      "type": "component",
      "repeatable": false,
      "component": "shared.intro",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "workflow": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service-item.service-item"
    },
    "portfolio_settings": {
      "type": "component",
      "repeatable": false,
      "component": "portfolio.settings",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "portfolio_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::portfolio-item.portfolio-item"
    },
    "testimonials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::testimonial-item.testimonial-item"
    }
  }
}
