{
  "kind": "collectionType",
  "collectionName": "styling_projects",
  "info": {
    "singularName": "styling-project",
    "pluralName": "styling-projects",
    "displayName": "Styling Project",
    "description": "Editable bilingual styling content; publish EN and VI separately."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "summary": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "body": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo_title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo_description": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "string",
      "required": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "gallery": {
      "type": "component",
      "repeatable": true,
      "component": "styling.gallery-image",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "credits": {
      "type": "component",
      "repeatable": true,
      "component": "styling.credit",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "source_url": {
      "type": "string",
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "video_url": {
      "type": "string",
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "cover_alt": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category_key": {
      "type": "enumeration",
      "enum": [
        "commercial",
        "celebrity",
        "editorial",
        "lookbook",
        "music",
        "personal"
      ],
      "required": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "social_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "social_image_alt": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "locked_slug": {
      "type": "string",
      "private": true,
      "configurable": false,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    }
  }
}
