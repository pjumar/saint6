{
  "kind": "collectionType",
  "collectionName": "key_projects",
  "info": {
    "singularName": "key-project",
    "pluralName": "key-projects",
    "displayName": "Key Project",
    "description": "Featured key projects for homepage showcase"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "client": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "info_text": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "expertise": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "team": {
      "type": "component",
      "repeatable": true,
      "component": "project.team-member",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "main_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "gallery_images": {
      "type": "component",
      "repeatable": true,
      "component": "shared.gallery-image"
    },
    "testimonial": {
      "type": "component",
      "repeatable": false,
      "component": "project.testimonial",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
