{
  "kind": "collectionType",
  "collectionName": "key_projects",
  "info": {
    "singularName": "key-project",
    "pluralName": "key-projects",
    "displayName": "Key Project",
    "description": "Featured key projects for homepage showcase"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "projectNumber": {
      "type": "string",
      "default": "01/01",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "client": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "infoText": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "expertise": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "team": {
      "type": "component",
      "repeatable": true,
      "component": "project.team-member"
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "galleryImages": {
      "type": "component",
      "repeatable": true,
      "component": "project.project-image"
    },
    "testimonial": {
      "type": "component",
      "repeatable": false,
      "component": "project.testimonial"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
