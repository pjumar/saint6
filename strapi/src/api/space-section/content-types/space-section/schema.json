{
  "kind": "singleType",
  "collectionName": "space_sections",
  "info": {
    "singularName": "space-section",
    "pluralName": "space-sections",
    "displayName": "Space Section",
    "description": "Wide Range of Space section on homepage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "caption": {
      "type": "string",
      "default": "WIDE RANGE OF SPACE",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cta_text": {
      "type": "string",
      "default": "VIEW STUDIO RENTAL",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cta_link": {
      "type": "string",
      "default": "/studio-rental",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "space.space-stat"
    },
    "gallery_images": {
      "type": "component",
      "repeatable": true,
      "component": "space.space-image"
    }
  }
}
