      "component": "shared.service-item"
    },
    "saint6_way_title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "saint6_way_description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "workflow": {
      "type": "component",
      "repeatable": true,
      "component": "shared.workflow-step"
    },
    "featured_project": {
      "type": "relation",
