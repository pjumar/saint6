    "intro": {
      "type": "component",
      "repeatable": false,
      "component": "shared.intro"
    },
    "stats": {
      "type": "component",
      "repeatable": false,
      "component": "studio.stats"
    },
    "rooms": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::studio-room.studio-room"
    },
    "full_rental": {
      "type": "component",
      "repeatable": false,
      "component": "studio.full-rental"
    },
    "facilities": {
      "type": "component",
      "repeatable": false,
      "component": "studio.facilities"
    },
    "equipment": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::equipment-item.equipment-item"
    },
    "faq_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq-item.faq-item"
    }
