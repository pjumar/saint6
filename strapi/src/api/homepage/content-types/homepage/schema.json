{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage",
    "description": "Homepage content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.hero"
    },
    "trusted_by": {
      "type": "component",
      "repeatable": false,
      "component": "homepage.trusted-by"
    },
    "brand_logos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::brand-logo.brand-logo"
    },
    "gallery_images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featured_project": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::key-project.key-project"
    },
    "space_section": {
      "type": "component",
      "repeatable": false,
      "component": "homepage.space-section"
    },
    "crew_area": {
      "type": "component",
      "repeatable": false,
      "component": "homepage.crew-area"
    }
  }
}
